{
  "name": "@repo/eslint-config",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome lint .",
    "check-types": "node --check eslint.config.base.mjs && node --check eslint.config.react.mjs && node --check eslint.config.next.mjs && node --check eslint.config.vite.mjs"
  },
  "exports": {
    "./eslint.base": "./eslint.config.base.mjs",
    "./eslint.react": "./eslint.config.react.mjs",
    "./eslint.next": "./eslint.config.next.mjs",
    "./eslint.vite": "./eslint.config.vite.mjs"
  },
  "files": ["*.mjs", "*.md"],
  "devDependencies": {
    "@eslint/js": "^9",
    "@next/eslint-plugin-next": "^16",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jsdoc": "^62",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-dom": "^2",
    "eslint-plugin-react-hooks": "^7",
    "eslint-plugin-react-refresh": "^0",
    "eslint-plugin-react-x": "^2",
    "eslint-plugin-turbo": "^2",
    "typescript-eslint": "^8"
  }
}
